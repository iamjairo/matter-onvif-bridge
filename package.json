{
  "name": "matter-onvif-bridge",
  "version": "0.1.0",
  "description": "Matter bridge that exposes ONVIF IP cameras as Matter camera devices",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "go2rtc:up": "docker compose up -d",
    "go2rtc:down": "docker compose down",
    "go2rtc:logs": "docker compose logs -f go2rtc",
    "up": "docker compose up -d && npm run dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.8.0",
  "license": "Apache-2.0",
  "dependencies": {
    "@matter/main": "0.17.0-alpha.0-20260402-bd064abc8",
    "@matter/model": "0.17.0-alpha.0-20260402-bd064abc8",
    "@matter/nodejs": "0.17.0-alpha.0-20260402-bd064abc8",
    "@matter/types": "0.17.0-alpha.0-20260402-bd064abc8",
    "dotenv": "^16.6.1",
    "onvif": "^0.8.1",
    "pino": "^9.14.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
