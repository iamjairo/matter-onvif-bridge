# ONVIF camera credentials (used for all cameras unless overridden)
ONVIF_USERNAME=admin
ONVIF_PASSWORD=admin

# ONVIF discovery interval in milliseconds (default: 60000)
ONVIF_DISCOVERY_INTERVAL=60000

# Static camera list (in addition to WS-Discovery auto-detection)
# Format: host:port,host:port,...
# Useful when cameras use non-standard ONVIF ports or multicast is unreliable
#ONVIF_STATIC_CAMERAS=192.168.1.10:2020,192.168.1.11:80

# go2rtc mode: "external" (Docker, default) or "local" (subprocess)
GO2RTC_MODE=external

# go2rtc binary path — only used when GO2RTC_MODE=local
GO2RTC_PATH=./bin/go2rtc

# go2rtc host — where the bridge reaches go2rtc's API
# Use "localhost" when go2rtc runs in Docker with ports mapped to the host
GO2RTC_HOST=localhost

# go2rtc API port (default: 1984)
GO2RTC_API_PORT=1984

# go2rtc WebRTC port (default: 8555)
GO2RTC_WEBRTC_PORT=8555

# Matter bridge settings
MATTER_PORT=5540
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840

# Storage path for Matter commissioning state
MATTER_STORAGE_PATH=.matter-storage

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
