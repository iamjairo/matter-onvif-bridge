# ONVIF camera credentials (used for all cameras unless overridden)
ONVIF_USERNAME=admin
ONVIF_PASSWORD=admin

# ONVIF discovery mode: "auto" (WS-Discovery + static list, periodic rescanning)
# or "static" (only use ONVIF_STATIC_CAMERAS, connect once at startup, no rescanning)
ONVIF_DISCOVERY_MODE=auto

# ONVIF discovery interval in milliseconds (default: 60000, only used in auto mode)
ONVIF_DISCOVERY_INTERVAL=60000

# Static camera list
# Format: host:port,host:port,...
# In "static" mode: this is the only source of cameras
# In "auto" mode: merged with WS-Discovery results
#ONVIF_STATIC_CAMERAS=192.168.1.10:2020,192.168.1.11:80

# Optional friendly-name overrides for cameras.
# Keys can be the camera's ONVIF serial number (preferred, survives IP changes)
# or a host/IP address as a fallback.
# Format: key=Friendly Name,key=Friendly Name,...
#ONVIF_CAMERA_NAMES=ABC123456=Front Door,192.168.1.12=Backyard

# Manual RTSP fallback cameras (explicit homelab reliability path).
# Format: name|rtsp_url[|stable_id];name|rtsp_url[|stable_id]
# - entries are separated by ';'
# - fields are separated by '|'
# - name and rtsp_url are required
# - stable_id is optional but recommended to keep the same Matter endpoint identity
# - name must not contain '|' or ';'
# These cameras bypass ONVIF discovery and are treated as reduced-capability/video-only
# unless ONVIF metadata exists through a separate ONVIF camera definition.
# When ONVIF/profile metadata is unavailable, the bridge advertises conservative
# fallback video capability values for this path instead of leaving them empty.
# If the same physical camera is configured both here and via ONVIF, V1 exposes them as
# separate bridged cameras; manual entries do not override or suppress ONVIF discovery.
#MANUAL_RTSP_CAMERAS=Front Door|rtsp://user:pass@192.168.1.10:554/stream1|front-door;Garage|rtsp://user:pass@192.168.1.11:554/live

# go2rtc mode: "external" (Docker, default) or "local" (subprocess)
GO2RTC_MODE=external

# go2rtc binary path — only used when GO2RTC_MODE=local
GO2RTC_PATH=./bin/go2rtc

# go2rtc host — where the bridge reaches go2rtc's API
# Use "localhost" when go2rtc runs in Docker with ports mapped to the host
GO2RTC_HOST=localhost

# go2rtc API port (default: 1984)
GO2RTC_API_PORT=1984

# go2rtc WebRTC port (default: 8555)
GO2RTC_WEBRTC_PORT=8555

# ── Media server selection ─────────────────────────────────────────────────────
# Choose between "go2rtc" (default) or "mediamtx" for RTSP→WebRTC bridging.
MEDIA_SERVER=go2rtc

# ── MediaMTX settings (only used when MEDIA_SERVER=mediamtx) ──────────────────

# mediamtx mode: "external" (Docker, default) or "local" (subprocess)
#MEDIAMTX_MODE=external

# mediamtx binary path — only used when MEDIAMTX_MODE=local
#MEDIAMTX_PATH=./bin/mediamtx

# mediamtx host — where the bridge reaches mediamtx's API and WHEP endpoint
#MEDIAMTX_HOST=localhost

# mediamtx HTTP API port (default: 9997)
#MEDIAMTX_API_PORT=9997

# mediamtx WHEP (WebRTC-HTTP Egress) port (default: 8889)
#MEDIAMTX_WHEP_PORT=8889

# Matter bridge settings
MATTER_PORT=5540
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840

# Storage path for Matter commissioning state
MATTER_STORAGE_PATH=.matter-storage

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
